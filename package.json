{
  "name": "dsh-theme-animal-island-ui",
  "version": "0.3.3",
  "description": "A high-fidelity Animal Island inspired DSH Web skin with ThemeRuntime tokens and public slots",
  "type": "module",
  "license": "MIT",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./client": {
      "types": "./lib/types/client/index.d.ts",
      "default": "./lib/client.js"
    },
    "./package.json": "./package.json"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-ui-theme",
        "@deepseek-ai/dsh-client-ui-renderer",
        "@deepseek-ai/dsh-client-ui-sidebar",
        "@deepseek-ai/dsh-client-ui-conversation"
      ],
      "immediately": true
    }
  },
  "files": [
    "lib",
    "README.md",
    "docs/compatibility.md",
    "docs/design.md",
    "docs/palette-preview.svg",
    "cordis.patch.yml",
    "THIRD_PARTY_NOTICES.md",
    "LICENSE",
    "licenses/Nunito-OFL.txt"
  ],
  "scripts": {
    "build": "node scripts/build.mjs",
    "typecheck": "tsc --noEmit",
    "test": "pnpm run build && node test/run.mjs",
    "check:compat": "pnpm run build && node scripts/check-compat.mjs",
    "prepack": "pnpm run build",
    "check": "pnpm run typecheck && pnpm run build && node test/run.mjs && node scripts/check-compat.mjs"
  },
  "devDependencies": {
    "@deepseek-ai/dsh-client-ui-conversation": "0.1.5-rc.3",
    "@deepseek-ai/dsh-client-ui-renderer": "0.1.5-rc.3",
    "@deepseek-ai/dsh-client-ui-sidebar": "0.1.5-rc.3",
    "@deepseek-ai/dsh-client-ui-slots": "0.1.5-rc.3",
    "@deepseek-ai/dsh-client-ui-theme": "0.1.5-rc.3",
    "@fontsource/nunito": "5.2.7",
    "@types/node": "24.0.10",
    "@types/react": "18.3.18",
    "esbuild": "0.25.6",
    "jsdom": "29.1.1",
    "lightningcss": "1.29.2",
    "react": "18.3.1",
    "typescript": "5.8.2"
  }
}
