{
  "name": "dsh-theme-animal-island-ui",
  "version": "0.1.3",
  "description": "A light-first cream, mint and periwinkle DSH Web theme inspired by Animal Island UI",
  "type": "module",
  "license": "MIT",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./client": {
      "types": "./lib/types/client/index.d.ts",
      "default": "./lib/client.js"
    },
    "./package.json": "./package.json"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-ui-theme"
      ],
      "immediately": true
    }
  },
  "files": [
    "lib",
    "README.md",
    "docs/compatibility.md",
    "docs/design.md",
    "docs/palette-preview.svg",
    "cordis.patch.yml",
    "THIRD_PARTY_NOTICES.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "node scripts/build.mjs",
    "typecheck": "tsc --noEmit",
    "test": "pnpm run build && node test/run.mjs",
    "check:compat": "pnpm run build && node scripts/check-compat.mjs",
    "prepack": "pnpm run build",
    "check": "pnpm run typecheck && pnpm run build && node test/run.mjs && node scripts/check-compat.mjs"
  },
  "devDependencies": {
    "@deepseek-ai/dsh-client-ui-theme": "0.1.5-rc.3",
    "@types/node": "24.0.10",
    "typescript": "5.8.2"
  }
}
